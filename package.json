{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "notion:sync": "node ./scripts/notion-sync.mjs --write --verbose",
    "notion:sync:dry": "node ./scripts/notion-sync.mjs --dry-run --verbose",
    "notion:sync:check": "node ./scripts/notion-sync.mjs --check --verbose",
    "preview": "npm run build && wrangler pages dev out",
    "deploy": "npm run build && wrangler pages deploy out --project-name website-elabs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "framer-motion": "^12.42.2",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.26.0",
    "motion-dom": "^12.42.2",
    "motion-utils": "^12.39.0",
    "next": "16.2.11",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-pretty-code": "^0.14.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^58.1.0",
    "wrangler": "^4.115.0"
