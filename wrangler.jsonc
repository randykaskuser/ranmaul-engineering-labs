{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website-elabs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_CACHE_WORKERS_KV",
      "id": "ec3980d1eb0f4c61a128587619f24530"
    }
  ],
  "routes": [
    {
      "pattern": "ranmaul.com",
      "custom_domain": true
    },
    {
      "pattern": "www.ranmaul.com",
      "custom_domain": true
    }
  ]
}
